NEXT_PUBLIC_SITE_URL=https://chronocal.tech
# Hosted web planner (NOT chronocal.tech/download — that is the marketing download page).
# Until DNS for app.chronocal.tech exists, use the Vercel production alias:
#   https://smart-calendar-kowenleskiw-8498s-projects.vercel.app
# After CNAME `app` → Vercel DNS target propagates, switch to:
#   https://app.chronocal.tech
NEXT_PUBLIC_APP_URL=https://smart-calendar-kowenleskiw-8498s-projects.vercel.app
# Hosted on the marketing site (app GitHub repo is private).
NEXT_PUBLIC_WINDOWS_INSTALLER_URL=https://chronocal.tech/downloads/Chronocal_0.1.4_x64-setup.exe
# Set after building the installer (PowerShell: Get-FileHash ... -Algorithm SHA256)
NEXT_PUBLIC_WINDOWS_INSTALLER_SHA256=

# Free Web3Forms access key → delivers /request submissions to hello@chronocal.tech
# Create at https://web3forms.com (free forever tier). Safe to expose as NEXT_PUBLIC_*.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
